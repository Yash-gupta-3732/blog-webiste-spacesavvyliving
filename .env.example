# SpaceSavvyLiving Configuration File
# Save a copy of this file as '.env' in the same folder and fill in the values below.

# Your Google Developer API Key with access to Blogger API v3
BLOGGER_API_KEY=YOUR_API_KEY_HERE

# Your Blogger Blog ID (found in the Blogger URL e.g. blogger.com/blog/themes/YOUR_BLOG_ID)
BLOGGER_BLOG_ID=YOUR_BLOG_ID_HERE

# The base canonical URL for your static website
SITE_URL=https://spacesavvyliving.com
